# ProdForge Multi-Provider Environment Configuration
# Provide at least one key, or leave blank to utilize the Offline Heuristic Engine & Local Ollama

# Primary LLM API Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Local Ollama endpoint
OLLAMA_HOST=http://localhost:11434

# Model override (optional: e.g. gemini-2.5-flash, gpt-4o, llama-3.3-70b-versatile)
PRODFORGE_MODEL=

# Studio Server Configuration
PRODFORGE_HOST=127.0.0.1
PRODFORGE_PORT=8000
